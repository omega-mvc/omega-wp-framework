{
    "name": "omega-mvc/omega-wp-framework",
    "description": "Omega WP Framework is a framework for creating WordPress plugins. It includes support for Database, Controllers, Validator, Routes, and more.",
    "version": "1.0.0",
    "type": "library",
    "license": "GPL-3.0",
    "authors": [
        {
            "name": "Adriano Giovannini",
            "homepage": "https://omega-mvc.github.io/"
        }
    ],
    "require": {
        "php": "^8.4",
        "vlucas/phpdotenv": "^5.6",
        "symfony/console": "^8.1",
        "symfony/finder": "^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "php-stubs/wordpress-stubs": "^6.9",
        "squizlabs/php_codesniffer": "^4.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "phpunit/php-code-coverage": "dev-omega as 14.3.5",
        "phpunit/phpunit": "^13.3",
        "tomasvotruba/type-coverage": "^2.4"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/omega-mvc/php-code-coverage"
        }
    ],
    "autoload": {
        "psr-4": {
            "Omega\\": "src/Omega/"
        },
        "files": [
            "src/Omega/Application/helper.php",
            "src/Omega/Environment/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/Tests"
        },
        "files": [
            "tests/Tests/Routing/helper.php"
        ]
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
