<?xml version="1.0"?>
<ruleset
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    name="PHP_CodeSniffer"
    xsi:noNamespaceSchemaLocation="./vendor/squizlabs/php_codesniffer/phpcs.xsd"
    >
    <description>The Omega coding standard. PSR12 + Types</description>
    <arg name="cache" value="cache/phpcs/phpcs.json" />
    <arg name="colors" />
    <arg value="p" />

    <file>./src</file>
    <file>./tests</file>

    <exclude-pattern>./tests/Tests/Support/fixtures</exclude-pattern>
    <exclude-pattern>./tests/Tests/fixtures/app/theme/resources/views</exclude-pattern>
    <rule ref="PSR12">
        <exclude name="PSR1.Methods.CamelCapsMethodName.NotCamelCaps" />
        <exclude name="PSR12.Files.FileHeader.IncorrectGrouping" />
    </rule>
    <!-- Facade @method annotations cannot be wrapped without breaking PHPStan resolution -->
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>./src/Omega/Database/Facade/DB.php</exclude-pattern>
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="0"/>
            <property name="ignoreComments" value="false"/>
        </properties>
    </rule>
</ruleset>
